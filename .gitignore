# Dataset (download from Kaggle: masoudnickparvar/brain-tumor-mri-dataset)
data/

# Python cache and editor settings
__pycache__/
.vscode/

# Kaggle upload bundle
*.zip

# KerasTuner trial folders: one checkpoint per trial, several GB in total (recreated by the tuning scripts)
**/hyperband*/
**/random_search*/

# Trained models (10-285 MB; GitHub rejects files over 100 MB). Run the scripts to recreate them
*.keras
# except the tuned CNN (9 MB; recreating it needs the 4-hour Hyperband search)
!02_supervised learning/results/cnn_tuning/tuned_cnn_best.keras

# Trained SVM (recreated by svm.py)
*.joblib
